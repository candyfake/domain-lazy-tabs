{
  "manifest_version": 3,
  "name": "Domain Lazy Tabs — 指定网站按需加载",
  "version": "1.1.0",
  "description": "指定域名的后台链接先进入本地等待页；可选点击才加载，或最多提前加载几个，关闭后自动补位。",
  "permissions": [
    "storage",
    "tabs"
  ],
  "minimum_chrome_version": "102",
  "background": { "service_worker": "background.js" },
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Domain Lazy Tabs 设置",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    },
    "default_popup": "options.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "park.html"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'"
  },
  "key": ""
}
